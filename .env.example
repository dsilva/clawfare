# Copy to a shell, or export before `./gradlew run --args="serve"`.
# The server reads these itself. They are never sent to the browser and never written to the cache.

# Google Flights via SerpApi. About 250 searches a month on the free plan.
SERPAPI_API_KEY=

# Google Flights via SearchAPI. Same offer shape, separate quota.
SEARCHAPI_API_KEY=

# Cached calendar fares. Labelled "cached", not a live price.
TRAVELPAYOUTS_API_TOKEN=

# Duffel test token (duffel_test_…). Every offer is labelled mock, even with a live token.
DUFFEL_ACCESS_TOKEN=

# Optional. Defaults are under ~/.local/share/clawfare/
# CLAWFARE_PORT=8080
# CLAWFARE_CACHE=
# CLAWFARE_SEARCHES=
# CLAWFARE_DB=
